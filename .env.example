# Firebase (client — same project for Next and Expo)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Expo (copy the same values with this prefix into apps/mobile/.env)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_WEB_ORIGIN=https://gracerun.vercel.app

# Admin seed script only (keep secret, never commit)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# MVP admin PIN (sessionStorage gate)
NEXT_PUBLIC_ADMIN_PIN=fusion2026

# App environment. Leave unset or "production" for live data.
# Use "staging" on the Vercel Preview / staging branch so Firestore uses *_test collections.
NEXT_PUBLIC_APP_ENV=production

# OTP emails (Resend). Without RESEND_API_KEY, codes are not emailed in production.
RESEND_API_KEY=
RESEND_FROM=GraceRun <onboarding@resend.dev>
OTP_SECRET=
