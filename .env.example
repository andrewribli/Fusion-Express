# Firebase (client — same project for Next and Expo)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Expo (copy the same values with this prefix into apps/mobile/.env)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_WEB_ORIGIN=https://gracerun.vercel.app

# Admin seed script only (keep secret, never commit)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# MVP admin PIN (sessionStorage gate)
NEXT_PUBLIC_ADMIN_PIN=fusion2026

# App environment. Leave unset or "production" for live data.
# Use "staging" on the Vercel Preview / staging branch so Firestore uses *_test collections.
NEXT_PUBLIC_APP_ENV=production

# OTP / order emails (Resend). Set on Vercel Production + Preview.
# Default sender branding — use a verified GraceRun domain address.
RESEND_API_KEY=
RESEND_FROM=GraceRun <verify@gracerun.fit>
# Optional override for admin mass messaging (defaults to hello@gracerun.fit)
RESEND_BROADCAST_FROM=GraceRun <hello@gracerun.fit>
OTP_SECRET=

# Firebase Admin (server routes: OTP existence checks, password reset, order alerts).
# Paste the full service-account JSON as a single-line env var on Vercel, OR use a local path.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Optional extra runner inboxes (comma-separated). All /users with emails also get
# order alerts; non-runners get a fun “become a runner” nudge.
RUNNER_ALERT_EMAIL=
# Owner inbox for “order delivered, please reimburse runner”
OWNER_ALERT_EMAIL=
# Always also emailed on new orders and new signups (hardcoded default is 1155233599@link.cuhk.edu.hk)
# Shown to customers after delivery (PayMe / FPS)
NEXT_PUBLIC_OWNER_PAYMENT_METHOD=PayMe
NEXT_PUBLIC_OWNER_PAYME_ID=
