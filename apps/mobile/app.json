{
  "expo": {
    "name": "GraceRun",
    "slug": "fusion-express",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fusionexpress",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "GraceRun uses photos for delivery proof."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
