{
  "expo": {
    "name": "GraceRun",
    "slug": "fusion-express",
    "owner": "gracerun",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fusionexpress",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ED1C24"
    },
    "plugins": [
      "expo-dev-client",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "GraceRun needs access to your photos to send images in chat, and for receipts and delivery proof.",
          "cameraPermission": "GraceRun needs access to your camera to take photos in chat, and for receipts and delivery proof."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ED1C24",
          "sounds": [],
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": false
          },
          "android": {
            "newArchEnabled": false,
            "targetSdkVersion": 36,
            "compileSdkVersion": 36
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "bcb10fe2-e2f2-40e6-a6dd-0c6337441e8a"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gracerun.fusionexpress",
      "buildNumber": "100",
      "usesAppleSignIn": true,
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "GraceRun needs access to your photos to send images in chat, and for receipts and delivery proof.",
        "NSCameraUsageDescription": "GraceRun needs access to your camera to take photos in chat, and for receipts and delivery proof.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ED1C24"
      },
      "package": "com.gracerun.fusionexpress",
      "versionCode": 96,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
