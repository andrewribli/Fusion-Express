rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Store catalog. Public read so aisle/menu pages can load without
    // racing Firebase Auth. Writes still require a signed-in user.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products_test/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public username → email lookup so people can sign in without being
    // authenticated first. Only the owner may write their mapping.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /usernames_test/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // OTP cookies are server-side. Never allow client access to email OTP docs.
    match /emailOtps/{email} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
