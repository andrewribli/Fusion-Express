{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_APP_ENV",
    "RESEND_API_KEY",
    "RESEND_FROM",
    "RESEND_REPLY_TO",
    "CRON_SECRET",
    "RESEND_BROADCAST_FROM",
    "ADMIN_EMAIL",
    "OWNER_ALERT_EMAIL",
    "RUNNER_ALERT_EMAIL",
    "OTP_SECRET",
    "FIREBASE_SERVICE_ACCOUNT_JSON",
    "AIRWALLEX_CLIENT_ID",
    "AIRWALLEX_API_KEY",
    "AIRWALLEX_WEBHOOK_SECRET",
    "AIRWALLEX_ENV",
    "NEXT_PUBLIC_AIRWALLEX_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "../../.next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
