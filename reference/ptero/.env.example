# Firebase (ptero-cityu)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ptero-cityu.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ptero-cityu
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ptero-cityu.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# CityU email OTP (HMAC cookie). Required for /api/otp/*
OTP_SECRET=

# Optional: send OTP via Resend. Without this, codes appear on-screen in prototype.
# RESEND_API_KEY=
# RESEND_FROM=Ptero <verify@gracerun.fit>
