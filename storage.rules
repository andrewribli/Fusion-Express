rules_version = '2';

/**
 * GraceRun Cloud Storage rules.
 *
 * Default deny: only the path prefixes below are reachable. There is no
 * catch-all `/{allPaths=**}` open-read rule.
 */
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImageUnder10mb() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /delivery-proofs/{orderId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && isImageUnder10mb();
    }

    match /receipts/{orderId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && isImageUnder10mb();
    }

    match /receipts/{campus}/{orderId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && isImageUnder10mb();
    }

    match /deliveries/{campus}/{orderId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && isImageUnder10mb();
    }

    match /bank-statements/{orderId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && isImageUnder10mb();
    }

    // Path embeds the uploader uid so Storage can enforce ownership without
    // a Firestore get. Admin review uses a signed-in admin session (Storage
    // has no cheap admin-collection check here).
    match /payment-submissions/{userId}/{orderId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == userId
        && isImageUnder10mb();
    }

    function isStorageAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function avatarWrite(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    // Owner and admin can read. Everyone else gets the file only if the
    // delivery-identity API hands them the download URL, which it withholds
    // for anonymous users and for people who are not on the order.
    match /avatars/{userId}/{fileName} {
      allow read: if signedIn() && (
        request.auth.uid == userId || isStorageAdmin()
      );
      allow write: if fileName == 'avatar.jpg' && avatarWrite(userId);
    }

    match /test/avatars/{userId}/{fileName} {
      allow read: if signedIn() && (
        request.auth.uid == userId || isStorageAdmin()
      );
      allow write: if fileName == 'avatar.jpg' && avatarWrite(userId);
    }

    function orderExists(orderId) {
      return firestore.exists(
        /databases/(default)/documents/orders/$(orderId)
      );
    }

    function orderDoc(orderId) {
      return firestore.get(
        /databases/(default)/documents/orders/$(orderId)
      ).data;
    }

    function hasUserProfile() {
      return firestore.exists(
        /databases/(default)/documents/users/$(request.auth.uid)
      );
    }

    function userProfile() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    // Mirrors Firestore isOrderCustomer / isOrderRunner (+ admin).
    // customerId / runnerUid are Auth uids; runnerId is a /runners doc id.
    // Admin is checked first so a missing/unreadable order cannot block admins.
    function isChatOrderParty(orderId) {
      return signedIn() && (
        isStorageAdmin() || isChatOrderCustomerOrRunner(orderId)
      );
    }

    function isChatOrderCustomerOrRunner(orderId) {
      return orderExists(orderId) && (
        orderDoc(orderId).get('customerId', '') == request.auth.uid
        || orderDoc(orderId).get('runnerUid', '') == request.auth.uid
        || (
          hasUserProfile()
          && userProfile().get('runnerId', '') != ''
          && orderDoc(orderId).get('runnerId', '')
            == userProfile().get('runnerId', '')
        )
      );
    }

    function isChatMediaObject() {
      return request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    // Order chat photos/videos: chats/{orderId}/{messageId}/{file}
    match /chats/{orderId}/{messageId}/{fileName} {
      allow read: if isChatOrderParty(orderId);
      allow write: if isChatOrderParty(orderId) && isChatMediaObject();
    }

    match /test/chats/{orderId}/{messageId}/{fileName} {
      allow read: if isChatOrderParty(orderId);
      allow write: if isChatOrderParty(orderId) && isChatMediaObject();
    }

    // Admin 1:1 chat media: adminChats/{userId}/{messageId}/{file}
    match /adminChats/{userId}/{messageId}/{fileName} {
      allow read: if signedIn() && (
        request.auth.uid == userId || isStorageAdmin()
      );
      allow write: if signedIn()
        && (request.auth.uid == userId || isStorageAdmin())
        && isChatMediaObject();
    }

    match /test/adminChats/{userId}/{messageId}/{fileName} {
      allow read: if signedIn() && (
        request.auth.uid == userId || isStorageAdmin()
      );
      allow write: if signedIn()
        && (request.auth.uid == userId || isStorageAdmin())
        && isChatMediaObject();
    }
  }
}
